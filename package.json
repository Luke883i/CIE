{
  "name": "cie-living-world",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:f2": "node --test tests/f2.test.mjs",
    "audit": "node scripts/audit.mjs",
    "verify": "npm test && npm run audit",
    "serve": "python3 -m http.server 8080",
    "audit:f3": "node scripts/audit_f3.mjs",
    "verify:f3": "npm test && npm run audit:f3",
    "audit:f4": "node scripts/audit_f4.mjs",
    "verify:f4": "npm test && npm run audit:f3 && npm run audit:f4",
    "audit:f5": "node scripts/audit_f5.mjs",
    "verify:f5": "npm test && npm run audit:f5",
    "audit:f6": "node scripts/audit_f6.mjs",
    "verify:f6": "npm test && npm run audit:f6",
    "audit:f7": "node scripts/audit_f7.mjs",
    "verify:f7": "npm test && npm run audit:f7",
    "test:f8": "node --test tests/f8.test.mjs",
    "audit:f8": "node scripts/audit_f8.mjs",
    "verify:f8": "npm test && npm run audit:f8",
    "audit:f8bis": "node scripts/audit_f8bis.mjs",
    "verify:f8bis": "npm test && npm run audit:f8 && npm run audit:f8bis",
    "audit:f10": "node scripts/audit_f10.mjs",
    "verify:f10": "npm test && npm run audit:f8 && npm run audit:f10",
    "audit:focus": "node scripts/audit_focus.mjs",
    "verify:focus": "npm run verify:f10 && npm run audit:focus"
  }
}

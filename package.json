{
  "name": "cie-living-world",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:f2": "node --test tests/f2.test.mjs",
    "audit": "node scripts/audit.mjs",
    "verify": "npm test && npm run audit",
    "serve": "python3 -m http.server 8080",
    "audit:f3": "node scripts/audit_f3.mjs",
    "verify:f3": "npm test && npm run audit:f3",
    "audit:f4": "node scripts/audit_f4.mjs",
    "verify:f4": "npm test && npm run audit:f3 && npm run audit:f4",
    "audit:f5": "node scripts/audit_f5.mjs",
    "verify:f5": "npm test && npm run audit:f5",
    "audit:f6": "node scripts/audit_f6.mjs",
    "verify:f6": "npm test && npm run audit:f6"
  }
}
